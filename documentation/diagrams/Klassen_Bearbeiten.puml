@startuml
' Klassenmodell der Kernlogik, Teil 2: Suche, Bearbeiten, Übersetzung, Querschnitt.
' Klassen aus Teil 1 erscheinen ohne Members im weissen Paket.
' Rendern: plantuml -tpng -charset UTF-8 Klassen_Bearbeiten.puml
' Höhere Auflösung, damit das Bild im PDF scharf bleibt.
skinparam dpi 240

skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor White
  BorderColor Black
}
skinparam package {
  BackgroundColor #F4F4F4
}
hide empty members

package "Suche" {
  class LabelSearch {
    Search(query) : IReadOnlyList<SearchHit>
  }
  class SearchQuery {
    Term : string
    Mode : SearchMode
    CaseSensitive : bool
  }
  enum SearchMode {
    ExactMatch
    Substring
    AnythingLike
    MatchWord
    Id
  }
  class SearchHit {
    Label : Label
    Score : int
  }
}

package "Bearbeiten" {
  class LabelOperations {
    Create(file, translations) : Label
    Update(label)
    Delete(label)
    Copy(label, target, updateReferences) : Label
    Move(label, target, updateReferences) : Label
  }
  class LabelIdGenerator {
    NewId(file) : LabelId
  }
  class UsageSearch {
    FindUsages(id) : IReadOnlyList<LabelUsage>
    ReplaceReferences(from, to) : int
  }
  class LabelUsage {
    Model : ModelInfo
    FilePath : string
    Line : int
    Column : int
  }
}

package "Übersetzung" {
  interface ITranslationService {
    TranslateAsync(text, source, targets, token)
  }
  class DeepLTranslationService
}

package "Querschnitt" {
  class LabelSettings {
    MetadataConfiguration : string
    PackageDirectories : IList<string>
    LoadLanguages : IList<string>
    CreateLanguages : IList<string>
    SourceLanguage : string
  }
  interface IMessageSink {
    Report(severity, message)
  }
}

package "Laden und Speichern" #FFFFFF {
  class LabelStore
  class LabelFileFormat
  class LabelFileWatcher
}

LabelSearch -up-> LabelStore
LabelSearch ..> SearchQuery
LabelSearch ..> SearchHit
SearchQuery --> SearchMode

LabelOperations --> LabelIdGenerator
LabelOperations --> UsageSearch
LabelOperations -up-> LabelStore
LabelOperations -up-> LabelFileFormat
LabelOperations -up-> LabelFileWatcher
UsageSearch ..> LabelUsage

ITranslationService <|.. DeepLTranslationService

' Anordnung: Laden und Speichern als Zeile oben, Suche und Bearbeiten darunter,
' Übersetzung und Querschnitt zuunterst.
LabelStore -[hidden]right- LabelFileFormat
LabelFileFormat -[hidden]right- LabelFileWatcher
SearchMode -[hidden]down- ITranslationService
LabelUsage -[hidden]down- LabelSettings
LabelSettings -[hidden]down- IMessageSink
@enduml
