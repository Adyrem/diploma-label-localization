@startuml
' Systemarchitektur der Extension: drei Projekte, Laufzeitumgebung und externe Systeme.
' Extension oben, Kernlogik darunter, Ablagen und Dienste unter dem Rahmen.
' Rendern: plantuml -tpng -charset UTF-8 Systemarchitektur.puml
' Höhere Auflösung, damit das Bild im PDF scharf bleibt.
skinparam dpi 240

skinparam defaultFontSize 13
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 20
skinparam ranksep 35

node "Visual Studio 2026, Prozess devenv.exe" as VS {

  package "Extension (VSIX, .NET Framework 4.8)" as EXT {
    component "Tool Window" as TW
    component "Commands und\nShortcuts" as CMD
    component "Einstellungen,\nAPI-Schlüssel" as SET
    component "Meldungen\n(Output Window)" as OUT
    component "QuickInfo-Quelle\n(MEF)" as QI
    component "Inline-Anzeige\n(MEF)" as INL
    component "Label-Erkennung\n(Classifier)" as REC
    component "Auswahl im Designer\n(Selection Tracking)" as SEL
  }

  component "Developer Tools\nvon Dynamics 365" as D365

  package "Kernlogik (.NET Standard 2.0)" as CORE {
    component "Suche und Ranking" as SEARCH
    component "Label Store" as STORE
    component "Label-Dateien\nlesen und schreiben" as IO
    component "Dateiüberwachung" as WATCH
    component "Model-Suche" as MOD
    component "Verwendungssuche und\nReferenzaktualisierung" as REF
    component "Übersetzungsdienst" as TR
  }
}

package "Testprojekt (.NET Framework 4.8)" as TEST {
  component "Unit Tests, laden die\nKernlogik im eigenen\nTestprozess" as UT
}

database "Package-Verzeichnis\n(Descriptor, Label-Dateien,\nXML der Elemente)" as PKG
cloud "Externer\nÜbersetzungsdienst" as SVC

' Anordnung: Zeilen der Extension
TW -[hidden]right- CMD
CMD -[hidden]right- SET
SET -[hidden]right- OUT
TW -[hidden]down- QI
QI -[hidden]right- INL
INL -[hidden]right- SEL
' Kernlogik unter der Extension
REC -[hidden]down- SEARCH
' Zeilen der Kernlogik
MOD -[hidden]right- REF
REF -[hidden]right- TR
PKG -[hidden]right- SVC

EXT ..> CORE : verwendet
QI --> REC
INL --> REC
REC .right.> D365 : Classification\nder Label-Token
SEL ..> D365 : gewähltes\nElement

SEARCH -right-> STORE
STORE -right-> IO
WATCH -up-> STORE
STORE --> MOD
IO --> PKG
MOD --> PKG
REF --> PKG
WATCH ..> PKG
TR --> SVC

TEST .up.> CORE
@enduml
