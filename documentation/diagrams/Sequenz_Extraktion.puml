@startuml
' Sequenz beim Extrahieren eines hardcodierten Textes im X++-Editor.
' Rendern: plantuml -tpng -charset UTF-8 Sequenz_Extraktion.puml
' Kurze, umbrochene Nachrichten halten das Diagramm schmal, damit die Schrift
' im PDF lesbar bleibt.
skinparam dpi 240

skinparam defaultFontSize 13
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  ActorBackgroundColor White
  ActorBorderColor Black
  LifeLineBorderColor Gray
  ArrowColor Black
}
hide footbox

actor "Entwickler" as DEV
participant "X++-\nEditor" as ED
participant "Command\nExtraktion" as CMD
participant "Label-\nErkennung" as REC
participant "ModelDiscovery" as MD
participant "Tool\nWindow" as TW
participant "ITranslationService" as TR
participant "LabelOperations" as OPS

DEV -> CMD : ruft die Extraktion\nauf einem markierten\nString Literal auf
activate CMD
CMD -> REC : String Literal\nan der Markierung
REC --> CMD : Span mit\n"X++ String"\noder keiner
alt kein String Literal
  CMD -> DEV : Hinweis, nichts geändert
else String Literal gefunden
  CMD -> MD : FindModelFor(\nPfad der Datei)
  MD --> CMD : Model mit\nLabel-Dateien
  CMD -> TW : neues Label mit Inhalt\ndes String Literals und\nvorgeschlagener Label-Datei
  activate TW
  TW -> TR : TranslateAsync(Text,\nSourceLanguage,\nCreateLanguages)
  loop je Zielsprache
    TR -> TR : Anfrage\nan den Dienst
  end
  alt Vorschläge\nerhalten
    TR --> TW : Übersetzungen
  else kein Schlüssel\noder Fehler
    TR --> TW : Fehler
    TW -> TW : Ausgangstext in\nallen Sprachen,\nMeldung mit Grund
  end
  DEV -> TW : prüft, ändert\nund bestätigt
  TW -> OPS : Create(Label-Datei,\nÜbersetzungen)
  activate OPS
  OPS -> OPS : NewId, im\nLabelStore\neintragen,\nÜberwachung\nanhalten, alle\nSprachen\nschreiben
  OPS --> TW : Label
  deactivate OPS
  TW --> CMD : Label-ID
  deactivate TW
  CMD -> ED : String Literal\ndurch die Label-ID\nersetzen
  note right of ED : ein Edit im\nText Buffer,\nrückgängig\nmachbar
end
deactivate CMD
@enduml
