<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Core logic without any dependency on Visual Studio (Z8, NFA03). .NET Standard 2.0
    knows neither WPF nor the Visual Studio SDK, so the core cannot depend on them by
    accident.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>BE.LabelExtension.Core</RootNamespace>
    <AssemblyName>BE.LabelExtension.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BE.LabelExtension.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reads compiled label resources without loading the assembly. Version 8 on purpose:
      Visual Studio 2022 and 2026 redirect it to the version they ship, which is newer.
    -->
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.1" />
  </ItemGroup>
</Project>
